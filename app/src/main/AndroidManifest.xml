<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.health.WRITE_STEPS" />

    <!-- 背景執行：health 類型前景服務與常駐通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 執行中持有 PARTIAL_WAKE_LOCK，鎖屏拔電時計時才不會被 CPU 休眠凍結。一般權限，安裝時自動授予。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        僅為滿足 health 類型前景服務的啟動前提（Android 14+ 須宣告此權限或取得指定的感測器／健康讀取權限之一）。
        StepSim 不讀取任何感測器。此為一般權限，安裝時自動授予、使用者無法撤銷。
        上架前（階段 10）改評估 specialUse 類型，詳見 CLAUDE.md。
    -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".StepSimApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepSim">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StepSim"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect 授權視窗的「說明」入口；缺少它授權視窗不會跳出 -->
        <activity
            android:name=".ui.PermissionsRationaleActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SimulationService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Android 14+：從 Health Connect 設定檢視權限用途 -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>